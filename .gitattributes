# Normaliza todos os arquivos texto para LF no repositório (sem avisos no Windows)
* text=auto eol=lf

# Arquivos texto explícitos
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf

# Arquivos binários (não conversão)
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
