{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "strict": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": [],
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  },
  "include": ["src/**/*"]
}