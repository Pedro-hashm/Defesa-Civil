DATABASE_URL="postgresql://postgres:123456@localhost:5433/defesa_civil"
FRONTEND_URL="http://localhost:3000"

# Prefixo e sufixo concatenados ao redor do hash antes do bcrypt (servidor).
# Mude para valores aleatórios longos em produção (ex: openssl rand -hex 16).
PASSWORD_PREFIXO="change_me_prefix"
PASSWORD_SUFIXO="change_me_suffix"

# reCAPTCHA v2 — chave secreta do servidor.
# Gere em: https://www.google.com/recaptcha/admin
# Chave de teste (apenas dev): 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET_KEY="change_me_recaptcha_secret"
